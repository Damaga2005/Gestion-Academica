# Copia este archivo a ".env" (mismo directorio que academico.db) y rellena los valores.
# El ".env" real NUNCA debe subirse a un repositorio ni compartirse: contiene secretos.

# Si se deja vacía o no se define, la app queda abierta (sin login), igual que hasta ahora.
# Si se define, se exige clave para acceder (ver README: sección "Bloqueo de la app").
GREELEC_LOCK_KEY=

# Clave de firma de las cookies de sesión de Flask. Recomendado definirla siempre que
# se use GREELEC_LOCK_KEY, para que las sesiones no se invaliden al reiniciar la app.
# Genera una con, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Host/puerto/debug del servidor Flask (solo aplican a "python app.py" y a la ventana
# de escritorio). Por defecto la app solo escucha en 127.0.0.1 (este equipo).
# Para permitir acceso desde otros dispositivos de tu red local (p. ej. el móvil),
# defínelo EXPLÍCITAMENTE aquí; nunca es el valor por defecto:
#   GREELEC_HOST=0.0.0.0
# GREELEC_HOST=127.0.0.1
# GREELEC_PORT=5000
# GREELEC_DEBUG=false
